         "title",
         "location"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Default: best_match with a query, else newest.",
      "title": "Sort"
     },
     "tier": {
      "default": "small",
      "description": "The caller's tool tier, which bounds the page.",
