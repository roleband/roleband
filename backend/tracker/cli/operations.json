      "description": "Only postings that state a pay band.",
      "title": "Discloses Pay",
      "type": "boolean"
     },
     "domain": {
      "description": "Domains (worlds), by slug or name.",
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "title": "Domain",
      "type": "array"
     },
     "family": {
      "description": "Role families, by slug or name.",
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "title": "Family",
      "type": "array"
     },
     "level_band": {
      "description": "Level bands, such as senior or staff.",
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "title": "Level Band",
      "type": "array"
     },
     "limit": {
      "default": 20,
      "description": "Most rows on one page.",
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     },
     "listed_within_days": {
      "anyOf": [
       {
        "maximum": 3650,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only postings listed within this many days, by the age each row shows.",
      "title": "Listed Within Days"
     },
     "location": {
      "description": "Places, by slug or a name people use, such as London or USA.",
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "title": "Location",
      "type": "array"
     },
     "minimum_estimated_pay": {
      "anyOf": [
       {
        "maximum": 100000000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Lowest estimated pay: the estimated total, else the estimated base.",
      "title": "Minimum Estimated Pay"
     },
     "order": {
      "default": "desc",
