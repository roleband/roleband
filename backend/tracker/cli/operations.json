      "description": "Words to search for, as in the Board's search box.",
      "title": "Query"
     },
     "saved_only": {
      "default": false,
      "description": "Only roles the person saved.",
      "title": "Saved Only",
      "type": "boolean"
     },
     "sort": {
      "anyOf": [
       {
        "enum": [
         "best_match",
         "newest",
         "age",
         "pay",
