{
  "name": "roleband-dashboard",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.1",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/ui/echartsRuntime.ts"
  ],
  "scripts": {
    "predev": "node scripts/gen-copy.mjs --no-twin",
    "dev": "vite",
    "prebuild": "node scripts/gen-copy.mjs --no-twin",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "prebuild:serve": "node scripts/gen-copy.mjs --no-twin",
    "build:serve": "tsc -b && vite build",
    "bundle:record": "vite build && node scripts/check-bundle-size.mjs --record",
    "test": "npm run test:unit && npm run test:ux",
    "pretest:unit": "node scripts/gen-copy.mjs --no-twin",
    "test:unit": "npm run typecheck:ux && vitest run",
    "test:unit:watch": "vitest",
    "pretest:ux": "node scripts/gen-copy.mjs --no-twin",
    "test:ux": "playwright test",
    "preview": "vite preview",
    "prelint": "node scripts/gen-copy.mjs --no-twin",
    "lint": "eslint .",
    "gen:api": "openapi-typescript openapi.json -o src/api.gen.ts",
    "gen:copy": "node scripts/gen-copy.mjs",
    "copy:check": "node scripts/copy-check.mjs",
    "audit:check": "node scripts/audit-gate.mjs",
    "preknip": "node scripts/gen-copy.mjs --no-twin",
    "knip": "knip --no-gitignore",
    "gen:brand-icons": "node scripts/gen-brand-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "pretypecheck:ux": "node scripts/gen-copy.mjs --no-twin",
    "typecheck:ux": "tsc --noEmit -p tsconfig.ux.json",
    "postinstall": "node scripts/gen-copy.mjs --no-twin",
    "copy:deck": "node scripts/copy/review.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "d3-geo": "^3.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.66.0",
    "motion": "^12.42.2",
    "posthog-js": "1.434.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fluent/bundle": "^0.19.1",
    "@fluent/syntax": "^0.19.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "rolldown": "^1.2.16",
    "simple-icons": "^16.36.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
