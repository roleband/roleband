<Window
    x:Class="RoleBand.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A tray flyout: a summary, the common tasks and one link, the Settings gear. Every target is at least
       40 by 40 so it works by touch. -->
  <Grid x:Name="Root" Width="360" VerticalAlignment="Top" Background="{ThemeResource RoleBandSurface}"
        AutomationProperties.AutomationId="Flyout">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Padding="16,10,8,2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image x:Name="AppMark" Width="28" Height="28" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock Grid.Column="1" Text="RoleBand" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="SettingsButton" Grid.Column="2" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
              AutomationProperties.AutomationId="FlyoutSettings">
        <FontIcon Glyph="&#xE713;" FontSize="16" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Padding="16,4,16,16" Spacing="8">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon x:Name="StateIcon" FontSize="16" Visibility="Collapsed" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="FlyoutTitle"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>
        <TextBlock x:Name="CornerText" Grid.Column="1" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AutomationId="FlyoutCorner" />
      </Grid>
      <ProgressBar x:Name="ScanProgress" Maximum="100" Visibility="Collapsed" AutomationProperties.AutomationId="FlyoutProgress" />
      <StackPanel x:Name="Lines" Spacing="2" Margin="0,2,0,0" AutomationProperties.AutomationId="FlyoutLines" />
      <!-- An update ready to install: a gold-tinted banner with its own press, so it cannot pass unnoticed. -->
      <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,6,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1"
              Background="{ThemeResource RoleBandNotice}" BorderBrush="{ThemeResource RoleBandNoticeStroke}"
              AutomationProperties.AutomationId="FlyoutUpdate" AutomationProperties.LiveSetting="Polite">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="UpdateGlyph" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource RoleBandGold}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="FlyoutUpdateTitle" />
              <TextBlock x:Name="UpdateCaption" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="UpdateButton" Grid.Column="2" MinHeight="32" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="FlyoutUpdateNow" />
          </Grid>
          <ProgressBar x:Name="UpdateProgress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.AutomationId="FlyoutMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <Border Grid.Row="2" Padding="16,12,16,16" BorderThickness="0,1,0,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Open Radar is the one gold action; a stopped engine's Restart takes its place. -->
        <Button x:Name="PrimaryButton" MinHeight="40" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.AutomationId="PrimaryAction" />
        <Button x:Name="ScanButton" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" Padding="8,5"
                AutomationProperties.AutomationId="ScanAction">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon x:Name="ScanGlyph" FontSize="14" />
            <TextBlock x:Name="ScanText" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button x:Name="DetailsButton" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" Visibility="Collapsed"
                AutomationProperties.AutomationId="Details" />
        <DropDownButton x:Name="PauseButton" Grid.Column="2" MinHeight="40" HorizontalAlignment="Stretch" Padding="8,5"
                        AutomationProperties.AutomationId="PauseScans">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE769;" FontSize="14" />
            <TextBlock x:Name="PauseText" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="PauseMenu" Placement="Bottom" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="ResumeButton" Grid.Column="2" MinHeight="40" HorizontalAlignment="Stretch" Padding="8,5" Visibility="Collapsed"
                AutomationProperties.AutomationId="ResumeScans">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE768;" FontSize="14" />
            <TextBlock x:Name="ResumeText" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
