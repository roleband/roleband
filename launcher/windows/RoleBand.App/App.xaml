<Application
    x:Class="RoleBand.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary>
          <!-- Gold is RoleBand's accent: the primary button, switches that are on, links and accent text.
               Framed windows layer neutral surfaces: a darker title bar (Native.Dress), a solid body with no
               wallpaper tint, and cards inset from the body without outlines. High contrast keeps the
               system's colours. -->
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="AccentButtonBackground" Color="#6A5C16" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7C6C22" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#5E5113" />
              <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
              <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
              <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#F2EEDC" />
              <SolidColorBrush x:Key="RoleBandGold" Color="#6A5C16" />
              <SolidColorBrush x:Key="RoleBandSurface" Color="#FFFFFF" />
              <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F1F3F4" />
              <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
              <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DADCE0" />
              <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#444746" />
              <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#6A5C16" />
              <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#6A5C16" />
              <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#7C6C22" />
              <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#5E5113" />
              <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6A5C16" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7C6C22" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#5E5113" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Default">
              <SolidColorBrush x:Key="AccentButtonBackground" Color="#DBCB90" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E8DCAC" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#C9B977" />
              <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A1705" />
              <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A1705" />
              <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1A1705" />
              <SolidColorBrush x:Key="RoleBandGold" Color="#DBCB90" />
              <SolidColorBrush x:Key="RoleBandSurface" Color="#3C3C3C" />
              <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#282828" />
              <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
              <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#4A4A4A" />
              <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C7C7C7" />
              <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#DBCB90" />
              <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#DBCB90" />
              <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#E8DCAC" />
              <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#C9B977" />
              <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#DBCB90" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E8DCAC" />
              <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C9B977" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A1705" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1705" />
              <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A1705" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
              <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="RoleBandGold" Color="{ThemeResource SystemColorHighlightColor}" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <!-- A settings row that opens something: the whole card is the target. -->
      <Style x:Key="SettingsCardButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
