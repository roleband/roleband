<Window
    x:Class="RoleBand.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28" RowSpacing="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="RoleBand" FontSize="28" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="EngineStatus" TextWrapping="Wrap" />
      <ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
      <Button x:Name="StartButton" AutomationProperties.AutomationId="StartEngine" />
      <Button x:Name="OpenButton" AutomationProperties.AutomationId="OpenDashboard" IsEnabled="False" />
      <Button x:Name="StopButton" AutomationProperties.AutomationId="StopEngine" IsEnabled="False" />
    </StackPanel>
    <Expander x:Name="Diagnostics" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto">
        <TextBlock x:Name="DiagnosticsText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Consolas" />
      </ScrollViewer>
    </Expander>
  </Grid>
</Window>
