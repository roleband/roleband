<Window
    x:Class="RoleBand.App.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The update window: the version, one line about it, the update's progress or failure, What's new and the
       window's buttons. Every target is at least 32 high, as the flyout's banner buttons are. -->
  <Grid x:Name="Root" Width="400" VerticalAlignment="Top" Padding="20" RowSpacing="14" Background="{ThemeResource RoleBandSurface}"
        AutomationProperties.AutomationId="UpdateWindow">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="AppMark" Width="52" Height="52" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="Heading" Grid.Column="1" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                 AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="UpdateWindowHeading" />
    </Grid>

    <TextBlock x:Name="Body" Grid.Row="1" TextWrapping="Wrap" LineHeight="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <!-- The update under way, or how it failed. -->
    <StackPanel x:Name="StepPanel" Grid.Row="2" Spacing="6" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                AutomationProperties.AutomationId="UpdateWindowStep">
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="StepGlyph" Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Collapsed"
                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock x:Name="StepTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <!-- Windows' own reason for a failed install can run long; the window keeps its buttons on screen and the tooltip
               and Narrator carry the whole of it. -->
          <TextBlock x:Name="StepDetail" FontSize="12" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
      <ProgressBar x:Name="StepProgress" Maximum="100" />
    </StackPanel>

    <Grid Grid.Row="3" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <HyperlinkButton x:Name="NotesLink" Padding="0" VerticalAlignment="Center" AutomationProperties.AutomationId="UpdateWindowNotes" />
      <Button x:Name="SecondButton" Grid.Column="1" MinHeight="32" MinWidth="88" AutomationProperties.AutomationId="UpdateWindowLater" />
      <Button x:Name="PrimaryButton" Grid.Column="2" MinHeight="32" MinWidth="88" Style="{StaticResource AccentButtonStyle}"
              AutomationProperties.AutomationId="UpdateWindowUpdate" />
    </Grid>
  </Grid>
</Window>
